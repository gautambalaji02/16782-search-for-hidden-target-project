<!--
  Kinova Gen3 6-DoF + Robotiq 2F-85 mounted on a table.

  Frames: the WORLD ORIGIN IS THE ARM BASE (bottom of base_link), +Z up, arm
  faces +X. So every world-frame pose MuJoCo reports is already in the robot
  base frame.
    - table surface:  z = 0
    - floor:          z = -0.75
    - table top 1.2 m (x) x 0.8 m (y), centred at x = +0.45, so the base is
      0.15 m in from the back edge.

  Open with:  python view.py        (or python -m mujoco.viewer --mjcf scenes/table_scene.xml)
-->
<mujoco model="gen3_table_scene">
  <!-- Robot (arm + gripper, home keyframe). Must come first so its joints are
       the first entries of qpos/ctrl. -->
  <include file="../models/gen3_6dof_robotiq_2f85.xml"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <statistic center="0.3 0 0.15" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop" rgba="0.55 0.40 0.27 1"/>
    <material name="tableleg" rgba="0.25 0.25 0.25 1"/>
  </asset>

  <worldbody>
    <light pos="0.45 0 2.5" dir="0 0 -1" directional="true"/>
    <light pos="1.5 -1 2" dir="-0.4 0.4 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table: fixed to the world (no joint). Surface at z = 0. -->
    <body name="table" pos="0.45 0 0">
      <geom name="table_top" type="box" pos="0 0 -0.02" size="0.6 0.4 0.02" material="tabletop" friction="1 0.005 0.0001"/>
      <geom name="leg_1" type="box" pos=" 0.56  0.36 -0.395" size="0.02 0.02 0.355" material="tableleg"/>
      <geom name="leg_2" type="box" pos=" 0.56 -0.36 -0.395" size="0.02 0.02 0.355" material="tableleg"/>
      <geom name="leg_3" type="box" pos="-0.56  0.36 -0.395" size="0.02 0.02 0.355" material="tableleg"/>
      <geom name="leg_4" type="box" pos="-0.56 -0.36 -0.395" size="0.02 0.02 0.355" material="tableleg"/>
    </body>

    <!-- A few objects to grasp (2F-85 max opening is 85 mm). -->
    <body name="red_cube" pos="0.50 0.0 0.025">
      <freejoint name="red_cube_joint"/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.85 0.15 0.15 1" mass="0.1" friction="1 0.005 0.0001"/>
    </body>
    <body name="green_cylinder" pos="0.55 0.20 0.04">
      <freejoint name="green_cylinder_joint"/>
      <geom type="cylinder" size="0.025 0.04" rgba="0.2 0.7 0.3 1" mass="0.1" friction="1 0.005 0.0001"/>
    </body>
    <body name="blue_box" pos="0.55 -0.20 0.015">
      <freejoint name="blue_box_joint"/>
      <geom type="box" size="0.03 0.05 0.015" rgba="0.2 0.35 0.85 1" mass="0.1" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <!-- Extra poses ("home" comes from the robot file). Values not listed (gripper
       linkage, objects) default to their initial positions. -->
  <keyframe>
    <!-- Wrist camera ~0.40 m above the table, looking down at the objects. -->
    <key name="table_view" qpos="0.004 0.093 -1.895 -0.001 -0.909 1.574"
         ctrl="0.004 0.093 -1.895 -0.001 -0.909 1.574 0"/>
  </keyframe>
</mujoco>
